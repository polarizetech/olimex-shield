#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""kit_ap — install and update KIT Adaptive Preregistration protocols in a git repo.

Installs protocol modules from the kit into a repo as committed, managed files:
  .agents/                     protocols, tools, this CLI, and kit_ap.lock (source, commit, file hashes)
  AGENTS.md                    managed block of always-on instructions (Codex, Copilot, Cursor, Gemini, ...)
  CLAUDE.md                    imports AGENTS.md so Claude Code reads the same rules
  .claude/settings.json        Claude Code hooks, merged into existing settings
  .github/hooks/kit_ap-*.json  Copilot / VS Code hooks

init, add, remove and update commit what they change (only those paths); pass --no-commit to skip.
Stdlib only (Python 3.9+). Needs git. macOS and Linux (Windows via WSL).
"""
import argparse, glob, hashlib, json, os, re, shutil, subprocess, sys, time

DEFAULT_SOURCE = "https://github.com/polarizetech/adaptive-preregistration.git"
# Earlier names of the default source. GitHub redirects them, and kit_ap records the current name instead.
FORMER_SOURCES = ("https://github.com/polarizetech/kit-adaptive-preregistration.git",)
DEFAULT_REF = "main"
NAME = "KIT Adaptive Preregistration"
AGENTS_DIR = ".agents"
LOCK = os.path.join(AGENTS_DIR, "kit_ap.lock")
SETTINGS = os.path.join(".claude", "settings.json")
START, END = "<!-- kit_ap:start -->", "<!-- kit_ap:end -->"
BLOCK_RE = re.compile(re.escape(START) + r".*?" + re.escape(END) + r"\n?", re.S)
LEGACY_BLOCK_RE = re.compile(r"\n*<!-- convo-log:start -->.*?<!-- convo-log:end -->\n?", re.S)  # old install.sh
MANAGED_CMD = re.compile(r"\.agents/(?:bin|tools)/|tools/convo-log")  # hook commands kit_ap owns
MODULE_META = {"module.json", "instructions.md", "hooks"}  # module entries that are not vendored as files
CHECK_TTL = 6 * 3600       # how long a successful update check is reused by the session-start hook
CHECK_FAIL_TTL = 30 * 60   # ...and a failed (e.g. offline) one, so sessions don't each wait for the timeout
HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
GIT_ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}


class Fail(Exception):
    """An expected failure: reported as one line, exit status 1."""


# ---------------------------------------------------------------- helpers

def git(*args, cwd=None, timeout=None):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=timeout, env=GIT_ENV)
    except subprocess.TimeoutExpired:
        return 1, "", "timed out"
    except FileNotFoundError:
        raise Fail("git is not installed") from None
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def repo_root(path):
    code, out, _ = git("rev-parse", "--show-toplevel", cwd=path or ".")
    if code:
        raise Fail(f"not a git repo: {os.path.abspath(path or '.')}")
    return out


def sha256(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_text(path, text):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def write_json(path, data):
    write_text(path, json.dumps(data, indent=2) + "\n")


def read_lock(repo):
    return read_json(os.path.join(repo, LOCK))


def prune_empty(repo, rel_dir):
    d = os.path.join(repo, rel_dir)
    while rel_dir and rel_dir != "." and os.path.isdir(d) and not os.listdir(d):
        os.rmdir(d)
        rel_dir = os.path.dirname(rel_dir)
        d = os.path.join(repo, rel_dir)


def modified_files(repo, lock):
    """Managed files whose content no longer matches what kit_ap installed."""
    out = []
    for rel, digest in sorted(((lock or {}).get("files") or {}).items()):
        p = os.path.join(repo, rel)
        if os.path.exists(p) and sha256(p) != digest:
            out.append(rel)
    return out


# ---------------------------------------------------------------- the kit

def is_kit(d):
    return os.path.isdir(os.path.join(d, "modules"))


def cache_dir(source):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "kit_ap", re.sub(r"[^A-Za-z0-9._-]+", "_", source).strip("_"))


def fetch(source, ref=DEFAULT_REF, commit=None):
    """Check out the kit at `commit`, or at `ref` (a branch or a tag), in the local cache; return its path."""
    if os.path.isdir(source):
        source = os.path.abspath(source)
    d = cache_dir(source)
    if os.path.isdir(os.path.join(d, ".git")):
        code, _, err = git("fetch", "--quiet", "--force", "--tags", "origin", cwd=d)
    else:
        shutil.rmtree(d, ignore_errors=True)
        code, _, err = git("clone", "--quiet", source, d)
    if code:
        raise Fail(f"cannot fetch kit from {source}: {err}")
    target = commit
    if not target:
        for candidate in (f"origin/{ref}", f"refs/tags/{ref}"):
            if git("rev-parse", "--verify", "--quiet", candidate + "^{commit}", cwd=d)[0] == 0:
                target = candidate
                break
        else:
            raise Fail(f"{source} has no branch or tag named {ref}")
    code, _, err = git("checkout", "--quiet", "--detach", target, cwd=d)
    if code:
        raise Fail(f"cannot check out {target} from {source}: {err}")
    return d


def canonical_source(source):
    """The current URL for a source the kit knows under an earlier name (the repo was renamed); else unchanged."""
    return DEFAULT_SOURCE if source in FORMER_SOURCES else source


def kit_info(kit):
    """Where this kit checkout came from and which commit it is at.

    The source is the checkout itself (not its remote) when its state isn't reproducible from the remote:
    uncommitted changes, or a HEAD no remote branch contains. Otherwise add/remove couldn't re-fetch it."""
    _, url, _ = git("remote", "get-url", "origin", cwd=kit)
    _, commit, _ = git("rev-parse", "HEAD", cwd=kit)
    _, dirty, _ = git("status", "--porcelain", cwd=kit)
    on_remote = bool(url) and bool(git("branch", "-r", "--contains", "HEAD", cwd=kit)[1])
    source = canonical_source(url) if on_remote and not dirty else os.path.abspath(kit)
    return {"source": source, "commit": commit or None, "dirty": bool(dirty)}


def load_modules(kit):
    mods = {}
    for mj in sorted(glob.glob(os.path.join(kit, "modules", "*", "module.json"))):
        m = read_json(mj)
        if m is None:
            raise Fail(f"unreadable {mj}")
        m["dir"] = os.path.dirname(mj)
        m.setdefault("name", os.path.basename(m["dir"]))
        mods[m["name"]] = m
    return mods


def resolve(mods, wanted):
    """`core` plus the wanted modules and their dependencies, dependencies first."""
    order = []

    def visit(name, chain):
        if name not in mods:
            raise Fail(f"unknown module: {name} (see `kit_ap list`)")
        if name in order:
            return
        if name in chain:
            raise Fail("module dependency cycle: " + " -> ".join(chain + [name]))
        for dep in mods[name].get("requires", []):
            visit(dep, chain + [name])
        order.append(name)

    for name in ["core", *wanted]:
        visit(name, [])
    return order


def module_files(m):
    """{repo-relative destination: source path} for everything a module vendors into .agents/."""
    out = {}
    for dirpath, dirnames, filenames in os.walk(m["dir"]):
        rel_dir = os.path.relpath(dirpath, m["dir"])
        if rel_dir == ".":
            dirnames[:] = [d for d in dirnames if d not in MODULE_META]
            filenames = [f for f in filenames if f not in MODULE_META]
        for fn in filenames:
            if fn == ".DS_Store" or fn.endswith(".pyc"):
                continue
            out[os.path.normpath(os.path.join(AGENTS_DIR, rel_dir, fn))] = os.path.join(dirpath, fn)
    return out


# ---------------------------------------------------------------- computing a repo's new state

def merged_settings(repo, add):
    """.claude/settings.json with kit_ap's hooks replaced by `add`; None if the file needn't exist."""
    path = os.path.join(repo, SETTINGS)
    cur = read_json(path)
    if cur is None and os.path.exists(path) and os.path.getsize(path):
        raise Fail(f"cannot parse {SETTINGS}; fix it and re-run")
    cur = cur or {}
    hooks = cur.get("hooks") or {}
    for event in list(hooks):
        kept = []
        for group in hooks[event]:
            hs = [h for h in group.get("hooks", []) if not MANAGED_CMD.search(h.get("command", ""))]
            if hs:
                kept.append({**group, "hooks": hs})
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    for event, groups in add.items():
        hooks.setdefault(event, []).extend(groups)
    if hooks:
        cur["hooks"] = hooks
    else:
        cur.pop("hooks", None)
    return json.dumps(cur, indent=2) + "\n" if cur or os.path.exists(path) else None


def agents_md(repo, block):
    """AGENTS.md with the managed block inserted or replaced. Refuses to guess if the markers are damaged."""
    text = LEGACY_BLOCK_RE.sub("", read_text(os.path.join(repo, "AGENTS.md")))
    starts, ends = text.count(START), text.count(END)
    if (starts, ends) == (0, 0):
        return (text.rstrip() + "\n\n" if text.strip() else "") + block
    if (starts, ends) != (1, 1) or text.index(START) > text.index(END):
        raise Fail(f"AGENTS.md has {starts} `{START}` and {ends} `{END}` marker(s); expected one of each, "
                   "in that order. Fix them by hand so nothing outside the block is lost, then re-run.")
    return BLOCK_RE.sub(lambda _: block, text, count=1)


def claude_md(repo):
    """CLAUDE.md importing AGENTS.md (Claude Code doesn't read AGENTS.md on its own); None if no change is needed."""
    path, agents = os.path.join(repo, "CLAUDE.md"), os.path.join(repo, "AGENTS.md")
    if os.path.exists(path) and os.path.realpath(path) == os.path.realpath(agents):
        return None  # CLAUDE.md is a symlink to AGENTS.md
    text = LEGACY_BLOCK_RE.sub("", read_text(path))
    if not re.search(r"^@AGENTS\.md\s*$", text, re.M):
        text = "@AGENTS.md\n" + ("\n" + text.lstrip("\n") if text.strip() else "")
    return text


def render_block(mods, order, source):
    parts = [START + f"\n<!-- Managed by {NAME} ({source}). Don't edit between these markers: "
                     "change the kit, then run `.agents/bin/kit_ap update`. -->"]
    for name in order:
        text = read_text(os.path.join(mods[name]["dir"], "instructions.md")).strip()
        if text:
            parts.append(text)
    parts.append(END)
    return "\n\n".join(parts) + "\n"


def plan(kit, repo, wanted, old, force):
    """Everything apply() will write, computed and validated before anything on disk changes."""
    mods = load_modules(kit)
    order = resolve(mods, wanted)
    info = kit_info(kit)

    edited = modified_files(repo, old)
    if edited and not force:
        raise Fail("managed files were edited in this repo:\n  " + "\n  ".join(edited) +
                   "\nMove those changes into the kit (or outside .agents/), or re-run with --force to overwrite them.")

    files = {os.path.join(AGENTS_DIR, "bin", "kit_ap"): os.path.join(kit, "bin", "kit_ap")}
    claude_hooks = {}
    for name in order:
        m = mods[name]
        for dest, src in module_files(m).items():
            if dest in files:
                raise Fail(f"{dest} is provided by more than one module")
            files[dest] = src
        copilot = os.path.join(m["dir"], "hooks", "copilot.json")
        if os.path.exists(copilot):
            files[os.path.join(".github", "hooks", f"kit_ap-{name}.json")] = copilot
        for event, groups in (read_json(os.path.join(m["dir"], "hooks", "claude.json"), {}).get("hooks") or {}).items():
            claude_hooks.setdefault(event, []).extend(groups)

    managed = set(old.get("files") or {})
    clobbered = [rel for rel, src in sorted(files.items())
                 if rel not in managed and os.path.isfile(os.path.join(repo, rel))
                 and sha256(os.path.join(repo, rel)) != sha256(src)]
    if clobbered and not force:
        raise Fail("these files already exist and aren't managed by kit_ap:\n  " + "\n  ".join(clobbered) +
                   "\nMove them aside, or re-run with --force to replace them.")

    return {
        "mods": mods, "order": order, "info": info, "files": files,
        "remove": sorted(rel for rel in managed if rel not in files),
        "texts": {  # repo-relative path -> new content (None: leave as is)
            SETTINGS: merged_settings(repo, claude_hooks),
            "AGENTS.md": agents_md(repo, render_block(mods, order, info["source"])),
            "CLAUDE.md": claude_md(repo),
        },
    }


# ---------------------------------------------------------------- applying it

def commit_changes(repo, paths, message):
    """Commit only the paths kit_ap touched; other staged or unstaged work in the repo is left as it was."""
    paths = sorted(p for p in set(paths)
                   if (os.path.lexists(os.path.join(repo, p)) or git("ls-files", "--error-unmatch", "--", p, cwd=repo)[0] == 0)
                   and git("check-ignore", "-q", "--", p, cwd=repo)[0] != 0)
    if not paths:
        return
    code, _, err = git("add", "-A", "--", *paths, cwd=repo)
    if code:
        print(f"kit_ap: couldn't stage the changes ({err}); commit them yourself")
        return
    if git("diff", "--cached", "--quiet", "--", *paths, cwd=repo)[0] == 0:
        return  # nothing changed
    code, _, err = git("commit", "--quiet", "-m", message, "--", *paths, cwd=repo)
    if code:
        print(f"kit_ap: changes are staged but the commit failed:\n  {err}\n"
              f"Fix that, then: git commit -m {json.dumps(message.splitlines()[0])}")
    else:
        print(f"kit_ap: committed \"{message.splitlines()[0]}\"")


def apply(kit, repo, wanted, force=False, ref=None, message=None):
    old = read_lock(repo) or {}
    p = plan(kit, repo, wanted, old, force)
    info, order = p["info"], p["order"]
    touched = [LOCK]

    for rel in p["remove"]:
        if os.path.exists(os.path.join(repo, rel)):
            os.remove(os.path.join(repo, rel))
            prune_empty(repo, os.path.dirname(rel))
            touched.append(rel)
    legacy = os.path.join(".github", "hooks", "convo-log.json")
    if "tools/convo-log" in read_text(os.path.join(repo, legacy)):
        os.remove(os.path.join(repo, legacy))
        touched.append(legacy)

    hashes = {}
    for rel, src in sorted(p["files"].items()):
        dst = os.path.join(repo, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(src, dst)
        shutil.copymode(src, dst)
        hashes[rel] = sha256(dst)
        touched.append(rel)
    for rel, text in p["texts"].items():
        if text is not None:
            write_text(os.path.join(repo, rel), text)
            touched.append(rel)
    write_json(os.path.join(repo, LOCK), {  # last, so an interrupted run never looks complete
        "source": info["source"], "ref": ref or old.get("ref") or DEFAULT_REF,
        "commit": info["commit"], "dirty": info["dirty"], "modules": order, "files": hashes})

    short = (info["commit"] or "")[:7] + (" (uncommitted kit changes)" if info["dirty"] else "")
    print(f"kit_ap: {repo} now at {short}; modules: {', '.join(order)}")
    for name in order:
        if name not in (old.get("modules") or []):
            for note in p["mods"][name].get("notes", []):
                print(f"  [{name}] {note.replace('{repo}', repo)}")
    for legacy_file in ("tools/convo-log", "CONVERSATIONS.md"):
        if os.path.exists(os.path.join(repo, legacy_file)) and "convo-log" in order:
            print(f"  note: {legacy_file} is from the old install.sh and now lives in .agents/; delete it")
    if message:
        commit_changes(repo, touched, f"{message}\n\nKit: {info['source']} @ {short}")
    else:
        print("Review and commit: git add .agents AGENTS.md CLAUDE.md .claude .github")


def run_apply(kit, repo, modules, force=False, ref=None, message=None):
    """Apply with the kit's own CLI, so a newer kit installs itself with its own logic."""
    if os.path.realpath(kit) == HERE:
        return apply(kit, repo, modules, force, ref, message)
    cmd = [sys.executable, os.path.join(kit, "bin", "kit_ap"), "_apply", repo, "--kit", kit,
           "--modules", ",".join(modules)] + (["--force"] if force else []) + (["--ref", ref] if ref else []) \
        + (["--message", message] if message else [])
    code = subprocess.run(cmd).returncode
    if code:
        sys.exit(code)


def installed_kit(lock):
    """The kit version a repo is pinned to, so add/remove never change the version of other modules."""
    if lock.get("dirty") and os.path.isdir(lock["source"]) and is_kit(lock["source"]):
        return lock["source"]  # installed from a local working tree; its commit alone isn't the full picture
    return fetch(canonical_source(lock["source"]), lock.get("ref", DEFAULT_REF), lock.get("commit"))


def require_lock(repo):
    lock = read_lock(repo)
    if not lock:
        raise Fail(f"kit_ap is not installed in {repo}; run `kit_ap init` first")
    return lock


def latest_commit(repo, lock, use_cache):
    """The commit `ref` (branch or tag) points to at the kit's source, or None if it can't be reached."""
    ref = lock.get("ref", DEFAULT_REF)
    _, gd, _ = git("rev-parse", "--git-common-dir", cwd=repo)
    cache = os.path.join(repo, gd or ".git", "kit_ap-check.json")
    source = canonical_source(lock["source"])
    key = f"{source}#{ref}"
    c = read_json(cache, {})
    if use_cache and c.get("key") == key:
        age = time.time() - c.get("ts", 0)
        if age < (CHECK_TTL if c.get("sha") else CHECK_FAIL_TTL):
            return c.get("sha")
    code, out, _ = git("ls-remote", source, f"refs/heads/{ref}", f"refs/tags/{ref}", f"refs/tags/{ref}^{{}}",
                       timeout=5)
    refs = dict(reversed(line.split("\t", 1)) for line in out.splitlines() if "\t" in line) if code == 0 else {}
    sha = refs.get(f"refs/heads/{ref}") or refs.get(f"refs/tags/{ref}^{{}}") or refs.get(f"refs/tags/{ref}")
    try:
        write_json(cache, {"key": key, "ts": time.time(), "sha": sha})
    except OSError:
        pass
    return sha


# ---------------------------------------------------------------- commands

def cmd_list(a):
    lock = None
    try:
        lock = read_lock(repo_root("."))
    except Fail:
        pass
    if is_kit(HERE) and not a.source:
        kit = HERE
    else:
        kit = fetch(a.source or canonical_source((lock or {}).get("source") or DEFAULT_SOURCE))
    have = set((lock or {}).get("modules") or [])
    for name, m in load_modules(kit).items():
        flags = ("installed " if name in have else "") + ("default " if m.get("default") else "")
        req = f" (requires {', '.join(m['requires'])})" if m.get("requires") else ""
        print(f"{name:20} {m.get('description', '')}{req}" + (f"  [{flags.strip()}]" if flags else ""))


def cmd_init(a):
    repo = repo_root(a.repo)
    old = read_lock(repo)
    if old and not a.force:
        raise Fail("kit_ap is already installed here; use `add`, `remove` or `update` (or --force)")
    if a.source:
        kit = fetch(a.source, a.ref or DEFAULT_REF)
    else:
        kit = HERE if is_kit(HERE) else fetch(DEFAULT_SOURCE, a.ref or DEFAULT_REF)
    if a.modules is not None:
        wanted = [m for m in a.modules.split(",") if m]
    elif old:
        wanted = old.get("modules") or []  # re-init keeps what's installed
    else:
        wanted = [n for n, m in load_modules(kit).items() if m.get("default")]
    run_apply(kit, repo, wanted, a.force, a.ref, None if a.no_commit else f"Add {NAME}")


def cmd_add(a):
    repo = repo_root(a.repo)
    lock = require_lock(repo)
    new = [m for m in a.modules if m not in lock["modules"]]
    run_apply(installed_kit(lock), repo, lock["modules"] + new, a.force,
              message=None if a.no_commit else f"Add {NAME} module: {', '.join(new or a.modules)}")


def cmd_remove(a):
    repo = repo_root(a.repo)
    lock = require_lock(repo)
    kit = installed_kit(lock)
    mods = load_modules(kit)
    if "core" in a.modules:
        raise Fail("core can't be removed")
    keep = [m for m in lock["modules"] if m not in a.modules]
    for m in keep:
        needed = set(mods.get(m, {}).get("requires", [])) & set(a.modules)
        if needed:
            raise Fail(f"{m} requires {', '.join(sorted(needed))}; remove {m} too")
    run_apply(kit, repo, keep, a.force, message=None if a.no_commit else f"Remove {NAME} module: {', '.join(a.modules)}")


def cmd_update(a):
    repo = repo_root(a.repo)
    lock = require_lock(repo)
    ref = a.ref or lock.get("ref", DEFAULT_REF)
    source = canonical_source(lock["source"])
    kit = fetch(source, ref)
    new = kit_info(kit)["commit"]
    if new == lock.get("commit") and source == lock["source"] and not lock.get("dirty") and not a.force:
        edited = modified_files(repo, lock)
        print("kit_ap: already up to date" + (f"; edited managed files: {', '.join(edited)}" if edited else ""))
        return
    # The update runs the fetched kit's own code, so say exactly what that is.
    print(f"kit_ap: updating from {source} ({ref}): {(lock.get('commit') or '?')[:7]} -> {new[:7]}")
    if source != lock["source"]:
        print(f"kit_ap: the kit repo was renamed; recording {source} instead of {lock['source']}")
    if source != DEFAULT_SOURCE:
        print(f"kit_ap: note: this repo's kit source isn't the default ({DEFAULT_SOURCE}); only continue if you trust it.")
    run_apply(kit, repo, lock["modules"], a.force, ref, None if a.no_commit else f"Update {NAME} to {new[:7]}")


def check(a):
    repo = repo_root(a.repo)
    lock = require_lock(repo)
    msgs = []
    edited = modified_files(repo, lock)
    if edited:
        msgs.append(f"managed files were edited locally ({', '.join(edited)}); update will refuse until that's resolved.")
    latest = latest_commit(repo, lock, use_cache=a.hook)
    installed = (lock.get("commit") or "")[:7]
    if latest and latest != lock.get("commit"):
        msgs.append(f"protocols are out of date (installed {installed}, latest {latest[:7]}); "
                    "`.agents/bin/kit_ap update` pulls them.")
    elif lock.get("dirty"):
        msgs.append(f"installed from a kit checkout with uncommitted changes ({installed}); run update once they're pushed.")
    if a.hook:
        if msgs:
            print("[kit_ap] " + " ".join(msgs) + " Mention this to the user once; don't update without their go-ahead.")
        return 0
    if latest is None:
        msgs.append(f"couldn't reach {lock['source']} to check for updates.")
    print("\n".join(f"kit_ap: {m}" for m in msgs) or f"kit_ap: up to date ({installed})")
    return 1 if msgs else 0


def cmd_check(a):
    if not a.hook:
        return check(a)
    try:  # session-start hook: never fail, never print a traceback into the agent's context
        return check(a)
    except Exception:
        return 0


def cmd_status(a):
    repo = repo_root(a.repo)
    lock = require_lock(repo)
    print(f"source:   {lock['source']} ({lock.get('ref', DEFAULT_REF)})")
    print(f"commit:   {lock.get('commit')}" + (" + uncommitted changes" if lock.get("dirty") else ""))
    print(f"modules:  {', '.join(lock['modules'])}")
    a.hook = False
    return check(a)


def cmd_apply(a):
    apply(a.kit, repo_root(a.repo), [m for m in a.modules.split(",") if m], a.force, a.ref, a.message)


def main():
    ap = argparse.ArgumentParser(prog="kit_ap", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def command(name, fn, help, repo="positional"):
        p = sub.add_parser(name, help=help, description=help)
        if repo == "positional":
            p.add_argument("repo", nargs="?", default=".", help="the repo to act on (default: current directory)")
        elif repo == "option":
            p.add_argument("--repo", default=".", help="the repo to act on (default: current directory)")
        p.set_defaults(fn=fn)
        return p

    def changes(p):
        p.add_argument("--force", action="store_true", help="overwrite managed or pre-existing files that differ")
        p.add_argument("--no-commit", action="store_true", help="leave the changes uncommitted")

    p = command("list", cmd_list, "list the kit's modules", repo=None)
    p.add_argument("--source", help="kit git URL or path to list from")
    p = command("init", cmd_init, "install the kit into a repo")
    p.add_argument("--modules", help="comma-separated modules (default: the kit's defaults; on re-init, what's installed)")
    p.add_argument("--source", help="kit git URL or path (default: this checkout, else the public kit)")
    p.add_argument("--ref", help="branch or tag of the kit to follow (default: main)")
    changes(p)
    for name, fn in (("add", cmd_add), ("remove", cmd_remove)):
        p = command(name, fn, f"{name} modules", repo="option")
        p.add_argument("modules", nargs="+", metavar="MODULE")
        changes(p)
    p = command("update", cmd_update, "pull the latest kit and re-apply it")
    p.add_argument("--ref", help="switch to following this branch or tag")
    changes(p)
    for name, fn, help in (("check", cmd_check, "is the kit out of date, or were managed files edited?"),
                           ("status", cmd_status, "installed version and modules, plus check")):
        p = command(name, fn, help)
        p.add_argument("--hook", action="store_true", help="session-start mode: quiet, cached, never fails")
    p = sub.add_parser("_apply")  # internal: update runs the fetched kit's own CLI through this
    p.add_argument("repo")
    p.add_argument("--kit", required=True)
    p.add_argument("--modules", default="")
    p.add_argument("--ref")
    p.add_argument("--force", action="store_true")
    p.add_argument("--message")
    p.set_defaults(fn=cmd_apply)

    a = ap.parse_args()
    try:
        sys.exit(a.fn(a) or 0)
    except Fail as e:
        if getattr(a, "hook", False):
            sys.exit(0)
        print(f"kit_ap: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
